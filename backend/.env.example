# 登录（JWT）。默认 AUTH_REQUIRED=false：本地开放，无 Token 也可调用接口。
# 完整步骤见 docs/LOCAL_SETUP.md。本文件复制为 backend/.env 后即可改，勿提交 .env。
# 若要强制登录：AUTH_REQUIRED=true，并修改 AUTH_JWT_SECRET 与默认密码
# AUTH_REQUIRED=false
# AUTH_JWT_SECRET=   # ./scripts/setup.sh 会在缺失时自动生成
# AUTH_TOKEN_TTL_HOURS=72
# AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# AUTH_BOOTSTRAP_USER_PASSWORD=

# 浏览器默认允许 http(s)://localhost / 127.0.0.1 / [::1] 的任意端口。
# 局域网前端或部署域名需登记完整来源（协议+主机+端口），逗号分隔，不支持 * 或路径。
# 相同主机自动加入 Host 白名单；无 Origin 的可信主机 CLI / Agent 请求保持可用。
# CORS_ALLOWED_ORIGINS=http://192.168.1.20:5175,https://stocks.example.com

# 可选：OpenAI 兼容接口，用于新闻潜在影响分析
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 本地新闻库 SQLite：backend/data/news.db（自动创建）

# K 线助手 / 大盘解读 / 新闻 LLM（优先使用；不填则回退到 OPENAI_*）
KLINE_ASSISTANT_API_KEY=
KLINE_ASSISTANT_API_BASE=
KLINE_ASSISTANT_MODEL=

# 跨提供商故障切换请优先在控制台保存；主通道失败后自动尝试备用提供商。

# Kimi（Moonshot）OpenAI 兼容：填 KIMI_API_KEY 后默认请求 https://api.moonshot.cn/v1 ，模型 moonshot-v1-8k
# （也可改用 KLINE_ASSISTANT_* 并手动设 BASE=https://api.moonshot.cn/v1、MODEL=moonshot-v1-8k）
# KIMI_API_KEY=
# KIMI_API_BASE=https://api.moonshot.cn/v1
# KIMI_MODEL=moonshot-v1-32k

# 学习资料与 Prompt 存项目根目录 kline_learning/（见 .gitignore）

# Tushare Pro（可选）：宏观/行业；在配置台选择 Tushare 为行情提供商时使用
TUSHARE_TOKEN=
# 可选：自定义数据接口根 URL（不设则走 Tushare 官方；设则赋值 pro._DataApi__http_url）
TUSHARE_DATA_API_URL=

# KlineShare 行情 API（可选，推荐）：https://data.klineshare.cn/docs
# 在配置台选择 KlineShare 并填写 API Key；也可在此或 integrations.json 配置
KLINESHARE_API_KEY=
KLINESHARE_API_BASE=https://data.klineshare.cn

# 行情扩展（腾讯 K 线兜底、东财/同花顺公开接口）；可选 HTTP 代理（也可写 backend/data/integrations.json，键名 adata_proxy_*）
ADATA_PROXY_ENABLED=false
ADATA_PROXY_IP=
ADATA_PROXY_URL=

# 可选本地行情库：free-stockdb Windows 本地 HTTP 服务。Mac 无法直接运行 exe；
# 可在 Windows 机器/虚拟机/兼容层启动 stockdb.exe 后，把地址填到这里作为 K 线兜底源。
FREE_STOCKDB_ENABLED=false
FREE_STOCKDB_BASE_URL=http://127.0.0.1:7899
FREE_STOCKDB_TIMEOUT_SEC=3

# A 股多源策略（也可写 backend/data/integrations.json 的同名小写键覆盖）
# 日线默认：东财 -> 腾讯 -> 百度 -> free-stockdb -> Baostock -> 新浪 -> Tushare -> Pytdx
# 分钟 K 线默认：东财 -> 腾讯 mkline -> Baostock -> Pytdx
# 股票列表默认：东财 -> 百度 -> 新浪
# MARKET_KLINE_DAILY_CHAIN=eastmoney,tencent,baidu,free_stockdb,baostock,sina,tushare,pytdx
# MARKET_KLINE_MINUTE_CHAIN=eastmoney,tencent_minute,baostock_minute,pytdx_minute
# MARKET_STOCK_UNIVERSE_CHAIN=eastmoney,baidu,sina

# 新闻解读：仅分析最近 N 天内条目（published_ts）；0=不限制
# NEWS_MAX_AGE_DAYS=0
# NEWS_RELEVANCE_THRESHOLD=60
# JSON 字段缺失或解析失败时的额外重试次数
# ANALYSIS_INTEGRITY_RETRIES=1
# 使用 LiteLLM 统一路由（与 pip litellm 配合）；false 为直连 OpenAI 兼容 HTTP
# USE_LITELLM=false
# LITELLM_MODEL=

# 量化交易 API 仍保留（/api/quant）；实盘转发模块未接入，以下配置预留
# QUANT_AGENT_URL=http://127.0.0.1:17800
# QUANT_AGENT_SECRET=

# 雪球 xueqiu.com：复制浏览器 Cookie 后粘贴（否则接口多返回 400016）；亦可写 integrations.json 键 xueqiu_cookies
# XUEQIU_COOKIES=
# XUEQIU_MIN_INTERVAL_SEC=1.2
# XUEQIU_MAX_RETRIES=2
# 公司资料、公告与资讯自动更新（服务运行期间；多实例只开启一个）
COMPANY_AUTO_REFRESH_ENABLED=true
COMPANY_REFRESH_INTERVAL_SEC=900
# 多 worker / 多副本时仅在一个独立调度实例设置 true
ENABLE_SCHEDULER=true

# 启动后异步自检/预热公开数据源：刷新过期股票列表、探测新闻源、预热大盘与股票列表行情缓存
# 多 worker / 多副本时建议仅在一个实例开启，避免重复请求外部源
# ENABLE_STARTUP_DATA_CHECK=true
# STARTUP_DATA_CHECK_DELAY_SEC=5
# STARTUP_DATA_CHECK_WATCHLIST_LIMIT=6
# 每次启动按游标轮转下一批股票，长期运行会逐步覆盖整个股票列表，而非反复只更新前 N 只
# STARTUP_STOCK_LIST_TTL_HOURS=24

# 统一数据资产管理：backend/data/_managed/catalog.json 记录缓存/配置索引；
# JSON 文件覆盖前保留最近 N 版备份，避免接口异常或误写导致数据丢失
# ENABLE_DATA_ASSET_BACKUPS=true
# DATA_ASSET_MAX_BACKUPS=5
